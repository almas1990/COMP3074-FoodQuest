<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/foodquest_green</item>
        <item name="android:navigationBarColor">@color/foodquest_ink</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>
    <style name="ScreenHeading">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/foodquest_ink</item>
        <item name="android:paddingBottom">16dp</item>
    </style>
    <style name="BodyText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/foodquest_ink</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="ActionButton" parent="@android:style/Widget.Material.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:backgroundTint">@color/foodquest_green</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>

